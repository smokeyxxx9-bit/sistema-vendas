{
  "name": "painel-vendas-oficina",
  "version": "1.0.1",
  "description": "Painel de Vendas e O.S. — Oficina",
  "main": "main.js",
  "author": "Oficina",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.oficina.painelvendas",
    "productName": "Painel de Vendas Oficina",
    "files": ["main.js", "web/**/*", "build/icon.ico"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Painel de Vendas Oficina"
    }
  }
}
